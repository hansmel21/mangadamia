# Copy to .env and adjust. On Railway, DATABASE_URL is injected automatically
# when you add a Postgres service and reference it from the API service.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/manga"
NODE_ENV="development"
SUPPORT_EMAIL="support@example.com"
DEVELOPER_LEGAL_NAME="Your legal name or company"
APP_USER_AGENT="MangaShelf/1.0 (support@example.com)"
ALLOWED_ORIGINS="http://localhost:8081"
TRUST_PROXY="false"

# External scraper service (the `scraper/` workspace). Catalog reads (browse,
# search, series, chapter pages) are proxied to it. Run it separately
# (`cd scraper && npm run dev`, default :4000). SCRAPER_API_KEY must match the
# value set in scraper/.env.
SCRAPER_URL="http://localhost:4000"
SCRAPER_API_KEY=""

# GIF picker (composer). Set ONE of these — Giphy key from developers.giphy.com
# (instant free key) or Tenor key from a Google Cloud project. Without a key
# the picker shows a "not configured" hint.
# GIPHY_API_KEY=""
# TENOR_API_KEY=""

# Post images (Social 3b). Leave unset in dev — uploads go to api/uploads on
# disk. For production set CLOUDINARY_URL (cloudinary://key:secret@cloudname);
# optionally CLOUDINARY_MODERATION (e.g. "aws_rek") to gate uploads through
# Cloudinary AI moderation for Play compliance.
# CLOUDINARY_URL=""
# CLOUDINARY_MODERATION=""
