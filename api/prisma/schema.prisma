// Database schema. Each Series/Chapter row is a cached copy of what a
// source site returned — the DB is a cache, the sources are the truth.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One row per real-world series, shared by every source that carries it.
// normTitles collects every normalized title/alt-title seen — the match keys.
model CanonicalSeries {
  id         String          @id @default(cuid())
  title      String
  coverUrl   String?
  normTitles String[]
  createdAt  DateTime        @default(now())
  series     Series[]
  comments   Comment[]
  readEvents ReadChapter[]
  library    LibraryEntry[]
  progress   Progress[]
  posts      Post[]
  postTags   PostSeriesTag[]
}

model User {
  id                   String                  @id @default(cuid())
  email                String                  @unique
  username             String                  @unique
  passwordHash         String
  createdAt            DateTime                @default(now())
  // Bumped (throttled, ≤1 write/5min) on any authenticated request — feeds
  // the per-guild "n ONLINE" presence.
  lastActiveAt         DateTime                @default(now())
  // Consecutive-days-active streak (UTC days), maintained by the same
  // auth-layer touch: same day = no-op, yesterday = +1, gap = reset to 1.
  streakDays           Int                     @default(0)
  streakDayKey         String?
  role                 String                  @default("user") // user | moderator | admin
  status               String                  @default("active") // active | suspended | banned
  suspendedUntil       DateTime?
  acceptedTermsVersion String?
  acceptedTermsAt      DateTime?
  // Denormalized XP: comment +10, like received +5, chapter read +2.
  // Level is derived: floor(sqrt(xp/100)) + 1.
  xp                   Int                     @default(0)
  // Weekly XP window for the Arena leaderboard (rolls over lazily on the
  // Monday-anchored UTC week boundary, same pattern as GuildMember).
  weeklyXp             Int                     @default(0)
  weekKey              String                  @default("")
  // Earned badge the user displays as their Title (validated on equip)
  // Legacy only. Badges remain collectible, but are no longer social Titles.
  equippedBadgeId      String?
  bio                  String?
  ageConfirmedAt       DateTime?
  usernameChangesLeft  Int                     @default(1)
  profileVisibility    String                  @default("public") // public | private
  showLevel            Boolean                 @default(true)
  showTitle            Boolean                 @default(true)
  showBadges           Boolean                 @default(true)
  showStats            Boolean                 @default(true)
  showPosts            Boolean                 @default(true)
  showFavorites        Boolean                 @default(false)
  showReadingHistory   Boolean                 @default(false)
  showFollows          Boolean                 @default(true)
  showJoinDate         Boolean                 @default(true)
  equippedTitleId      String?
  equippedAvatarId     String?
  equippedFrameId      String?
  equippedTitle        TitleDefinition?        @relation("EquippedTitle", fields: [equippedTitleId], references: [id], onDelete: SetNull)
  equippedAvatar       CosmeticDefinition?     @relation("EquippedAvatar", fields: [equippedAvatarId], references: [id], onDelete: SetNull)
  equippedFrame        CosmeticDefinition?     @relation("EquippedFrame", fields: [equippedFrameId], references: [id], onDelete: SetNull)
  sessions             Session[]
  comments             Comment[]
  likes                CommentLike[]
  notifications        Notification[]          @relation("NotificationRecipient")
  actedNotifications   Notification[]          @relation("NotificationActor")
  badges               UserBadge[]
  readChapters         ReadChapter[]
  library              LibraryEntry[]
  progress             Progress[]
  posts                Post[]
  postLikes            PostLike[]
  reports              Report[]
  blocking             Block[]                 @relation("Blocker")
  blockedBy            Block[]                 @relation("Blocked")
  moderationActions    ModerationAction[]      @relation("ModeratorActions")
  titles               UserTitle[]
  cosmetics            UserCosmetic[]
  following            Follow[]                @relation("Follower")
  followers            Follow[]                @relation("Following")
  activityEvents       ActivityEvent[]
  questProgress        UserQuestProgress[]
  xpTransactions       XpTransaction[]
  rewardGrants         RewardGrant[]
  pushDevices          PushDevice[]
  notificationPrefs    NotificationPreference?
  moderationNotices    ModerationNotice[]
  appeals              Appeal[]                @relation("AppealingUser")
  reviewedAppeals      Appeal[]                @relation("AppealReviewer")
  usernameChanges      UsernameChange[]
  guildMembership      GuildMember?
  guildJoinRequests    GuildJoinRequest[]
  guildInvites         GuildInvite[]        @relation("GuildInviteRecipient")
  guildInvitesSent     GuildInvite[]        @relation("GuildInviteSender")
  guildXpContributions GuildXpTransaction[]
  gateMemberships      GateMember[]
  gateJoinRequests     GateJoinRequest[]
  pollVotes            PollVote[]
  arenaEntries         ArenaEntry[]
  arenaVotes           ArenaVote[]
}

// ── Arena: scheduled weekly games (ARENA_PLAN.md, phase 1) ─────────────────
// Status is computed on read from startsAt/endsAt (upcoming | live | ended);
// finalizedAt marks the lazy close-out that pays winner rewards.
model ArenaEvent {
  id          String       @id @default(cuid())
  kind        String // "quiz" | "poll" | "draw"
  title       String
  description String
  startsAt    DateTime
  endsAt      DateTime
  canonicalId String? // optional series focus
  // quiz: { questions: [{ q, options[<=4], correct }], durationSec }
  // poll: { options: string[] }
  // draw: { prompt: string }
  config      Json
  finalizedAt DateTime?
  createdAt   DateTime     @default(now())
  entries     ArenaEntry[]
  votes       ArenaVote[]

  @@index([endsAt])
}

// Draw-competition votes: voters aren't entrants, one vote per reader per
// event, re-voting moves it (same rule as prediction pools).
model ArenaVote {
  eventId   String
  voterId   String
  entryId   String
  createdAt DateTime   @default(now())
  event     ArenaEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  entry     ArenaEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  voter     User       @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@id([eventId, voterId])
  @@index([entryId])
}

model ArenaEntry {
  id        String      @id @default(cuid())
  eventId   String
  userId    String
  // quiz: { answers: number[], ms: number }; poll: { option: number }
  // draw: { imageUrl: string, caption?: string }
  payload   Json
  score     Int?
  createdAt DateTime    @default(now())
  event     ArenaEvent  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  votes     ArenaVote[]

  @@unique([eventId, userId]) // one entry per reader per event
  @@index([eventId, score])
}

// Titles are independent social identity rewards. They never grant authority;
// staff capability comes only from User.role.
model TitleDefinition {
  id             String            @id
  name           String
  description    String
  rarity         String            @default("common") // common | rare | epic | legendary | mythic
  sourceType     String            @default("quest") // default | quest | event | staff | admin
  availableFrom  DateTime?
  availableUntil DateTime?
  isActive       Boolean           @default(true)
  sortOrder      Int               @default(0)
  createdAt      DateTime          @default(now())
  owners         UserTitle[]
  equippedBy     User[]            @relation("EquippedTitle")
  rewardedBy     QuestDefinition[] @relation("QuestTitleReward")
}

model UserTitle {
  userId     String
  titleId    String
  source     String          @default("quest")
  grantedBy  String?
  unlockedAt DateTime        @default(now())
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      TitleDefinition @relation(fields: [titleId], references: [id], onDelete: Cascade)

  @@id([userId, titleId])
  @@index([titleId, unlockedAt])
}

// Curated, app-owned profile art only. User image uploads intentionally remain
// unsupported until an image moderation pipeline exists.
model CosmeticDefinition {
  id             String            @id
  name           String
  description    String
  kind           String // avatar | frame
  rarity         String            @default("common")
  assetKey       String
  primaryColor   String?
  secondaryColor String?
  availableFrom  DateTime?
  availableUntil DateTime?
  isActive       Boolean           @default(true)
  sortOrder      Int               @default(0)
  createdAt      DateTime          @default(now())
  owners         UserCosmetic[]
  avatarUsers    User[]            @relation("EquippedAvatar")
  frameUsers     User[]            @relation("EquippedFrame")
  rewardedBy     QuestDefinition[] @relation("QuestCosmeticReward")
}

model UserCosmetic {
  userId     String
  cosmeticId String
  source     String             @default("quest")
  grantedBy  String?
  unlockedAt DateTime           @default(now())
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  cosmetic   CosmeticDefinition @relation(fields: [cosmeticId], references: [id], onDelete: Cascade)

  @@id([userId, cosmeticId])
  @@index([cosmeticId, unlockedAt])
}

model Follow {
  followerId  String
  followingId String
  status      String    @default("accepted") // pending | accepted
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?
  follower    User      @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User      @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId, status, createdAt])
  @@index([followerId, status, createdAt])
}

model UsernameChange {
  id               String   @id @default(cuid())
  userId           String
  previousUsername String
  newUsername      String
  grantedByAdmin   Boolean  @default(false)
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Cloud copy of the on-device library (followed series), canonical-keyed so
// it's server-independent; source/sourceSeriesId remember which "server" the
// user follows it on.
model LibraryEntry {
  userId         String
  canonicalId    String
  source         String
  sourceSeriesId String
  addedAt        DateTime        @default(now())
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  canonical      CanonicalSeries @relation(fields: [canonicalId], references: [id], onDelete: Cascade)

  @@id([userId, canonicalId])
}

// Cloud copy of reading position per series (last-write-wins on updatedAt)
model Progress {
  userId        String
  canonicalId   String
  chapterNumber Float
  pageIndex     Int             @default(0)
  pageCount     Int?
  updatedAt     DateTime        @default(now())
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  canonical     CanonicalSeries @relation(fields: [canonicalId], references: [id], onDelete: Cascade)

  @@id([userId, canonicalId])
}

// badgeId keys into the static catalog in src/badges.ts (names/icons live in
// code so artwork can be swapped without touching the DB).
model UserBadge {
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
}

// Server-side record of chapters read (signed-in users only). Powers reading
// badges/XP now; the basis for cross-device sync later.
model ReadChapter {
  userId        String
  canonicalId   String
  chapterNumber Float
  readAt        DateTime        @default(now())
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  canonical     CanonicalSeries @relation(fields: [canonicalId], references: [id], onDelete: Cascade)

  @@id([userId, canonicalId, chapterNumber])
  // Weekly per-series leaderboards scan by series + first-read window.
  @@index([canonicalId, readAt])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// Comments hang off the canonical series + chapter NUMBER, so one thread per
// chapter no matter which server it's read on.
model Comment {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  canonicalId      String
  canonical        CanonicalSeries @relation(fields: [canonicalId], references: [id], onDelete: Cascade)
  chapterNumber    Float
  body             String
  isSpoiler        Boolean         @default(false)
  createdAt        DateTime        @default(now())
  moderationStatus String          @default("visible") // visible | removed
  moderationReason String?
  moderatedAt      DateTime?
  likes            CommentLike[]
  // Single-level threading: replies point at a top-level comment
  parentId         String?
  parent           Comment?        @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies          Comment[]       @relation("Replies")
  notifications    Notification[]

  @@index([canonicalId, chapterNumber])
}

// In-app inbox: created when someone replies to your comment or post
model Notification {
  id           String    @id @default(cuid())
  userId       String // recipient
  user         User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId      String?
  actor        User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  kind         String    @default("reply")
  title        String?
  safeBody     String?
  targetUrl    String?
  metadata     Json?
  dedupeKey    String?
  priority     String    @default("normal")
  expiresAt    DateTime?
  commentId    String? // legacy source link; generic notifications need neither
  comment      Comment?  @relation(fields: [commentId], references: [id], onDelete: SetNull)
  postId       String?
  post         Post?     @relation(fields: [postId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  seenAt       DateTime?
  readAt       DateTime?
  dismissedAt  DateTime?
  pushQueuedAt DateTime?

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationPreference {
  userId        String  @id
  pushEnabled   Boolean @default(false)
  replies       Boolean @default(true)
  reactions     Boolean @default(true)
  follows       Boolean @default(true)
  quests        Boolean @default(true)
  newChapters   Boolean @default(false)
  announcements Boolean @default(true)
  user          User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushDevice {
  id         String    @id @default(cuid())
  userId     String
  expoToken  String    @unique
  platform   String
  locale     String?
  deviceName String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

// The social wall: reader posts, optionally anchored to a series/chapter.
// Same single-level threading model as comments.
model Post {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  canonicalId      String?
  canonical        CanonicalSeries? @relation(fields: [canonicalId], references: [id], onDelete: SetNull)
  chapterNumber    Float?
  body             String
  // System Record type: record | theory | review | spoiler_intel | poll
  kind             String           @default("record")
  // Optional headline for top-level records (replies never carry one).
  title            String?
  // 1–5 rating, reviews only (drives the community series rank)
  rating           Int?
  // Hosted GIF attachment URL. Phase 3 starts with provider-hosted GIFs so
  // there is no user-upload storage or moderation pipeline yet.
  gifUrl           String?
  // Uploaded photo attachments (max 4) — storage.ts URLs only (local
  // "/uploads/…" in dev, Cloudinary in prod).
  imageUrls        String[]         @default([])
  isSpoiler        Boolean          @default(false)
  // THE SYSTEM's official announcements: server-set only (admin endpoints),
  // rendered without the author's identity; `pinned` holds them atop the feed.
  isOfficial       Boolean          @default(false)
  createdAt        DateTime         @default(now())
  moderationStatus String           @default("visible") // visible | removed | gate_removed
  moderationReason String?
  moderatedAt      DateTime?
  likes            PostLike[]
  parentId         String?
  parent           Post?            @relation("PostReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies          Post[]           @relation("PostReplies")
  // Top-level post this reply belongs to (null for a top-level post). Lets the
  // whole conversation be fetched in one query for Reddit-style nested threads.
  rootId           String?
  root             Post?            @relation("PostThread", fields: [rootId], references: [id], onDelete: Cascade)
  threadReplies    Post[]           @relation("PostThread")
  // When set, this is a post on a guild's members-only wall (not the public feed).
  guildId          String?
  guild            Guild?           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  // When set, this post lives inside a Gate (Reddit-style community). Gate
  // posts stay off the main wall unless promoted (see promotedAt).
  gateId           String?
  gate             Gate?            @relation(fields: [gateId], references: [id], onDelete: Cascade)
  // Set when a gate post crosses the reaction threshold: it surfaces on the
  // main Dungeon wall (never for private gates). Sticky — cleared only when
  // the gate turns private.
  promotedAt       DateTime?
  // Guild board / gate feed: officers or wardens pin a post to the top.
  pinned           Boolean          @default(false)
  // Quote-repost: this post embeds and comments on another top-level post.
  quotedPostId     String?
  quotedPost       Post?            @relation("QuotedPost", fields: [quotedPostId], references: [id], onDelete: SetNull)
  quotedBy         Post[]           @relation("QuotedPost")
  notifications    Notification[]
  seriesTags       PostSeriesTag[]
  pollOptions      PollOption[]
  pollVotes        PollVote[]

  @@index([canonicalId, createdAt])
  @@index([createdAt])
  @@index([rootId])
  @@index([guildId, createdAt])
  @@index([gateId, createdAt])
  @@index([promotedAt, createdAt])
  @@index([canonicalId, kind])
  @@index([isOfficial, pinned, createdAt])
}

// A choice on a poll post; vote tallies come from PollVote.
model PollOption {
  id       String     @id @default(cuid())
  postId   String
  text     String
  position Int        @default(0)
  post     Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  votes    PollVote[]

  @@index([postId, position])
}

// One vote per reader per poll (changing your vote updates the row).
model PollVote {
  userId    String
  postId    String
  optionId  String
  createdAt DateTime   @default(now())
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([optionId])
}

model PostSeriesTag {
  postId        String
  canonicalId   String
  chapterNumber Float?
  position      Int             @default(0)
  post          Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  canonical     CanonicalSeries @relation(fields: [canonicalId], references: [id], onDelete: Cascade)

  @@id([postId, canonicalId])
  @@index([canonicalId, position])
}

model PostLike {
  userId    String
  postId    String
  // Reaction type: like | hype | mindblown | pain | dead. Any reaction (the
  // first one a reader leaves on a post) grants the author EXP.
  type      String   @default("like")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, postId])
  @@index([postId, type])
}

// Safety: user reports (reviewed by the admin during moderation)
model Report {
  id         String    @id @default(cuid())
  reporterId String
  reporter   User      @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  targetType String // "post" | "comment" | "user"
  targetId   String
  reason     String?
  createdAt  DateTime  @default(now())
  status     String    @default("pending") // pending | resolved | dismissed
  resolution String?
  reviewedAt DateTime?

  @@index([createdAt])
  @@index([status, createdAt])
}

model ModerationAction {
  id                String             @id @default(cuid())
  moderatorId       String?
  moderator         User?              @relation("ModeratorActions", fields: [moderatorId], references: [id], onDelete: SetNull)
  moderatorSnapshot String
  reportId          String?
  targetType        String
  targetId          String
  action            String
  reasonCode        String             @default("other")
  reason            String?
  beforeSnapshot    Json?
  afterSnapshot     Json?
  requestId         String?
  createdAt         DateTime           @default(now())
  notices           ModerationNotice[]
  appeals           Appeal[]

  @@index([targetType, targetId])
  @@index([createdAt])
}

model ModerationNotice {
  id                      String            @id @default(cuid())
  userId                  String
  moderationActionId      String?
  kind                    String // warning | suspension | ban | content_removed
  message                 String
  requiresAcknowledgement Boolean           @default(true)
  acknowledgedAt          DateTime?
  createdAt               DateTime          @default(now())
  user                    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  moderationAction        ModerationAction? @relation(fields: [moderationActionId], references: [id], onDelete: SetNull)

  @@index([userId, acknowledgedAt, createdAt])
}

model Appeal {
  id                 String           @id @default(cuid())
  userId             String
  moderationActionId String
  message            String
  status             String           @default("pending") // pending | upheld | overturned
  response           String?
  reviewerId         String?
  createdAt          DateTime         @default(now())
  reviewedAt         DateTime?
  user               User             @relation("AppealingUser", fields: [userId], references: [id], onDelete: Cascade)
  moderationAction   ModerationAction @relation(fields: [moderationActionId], references: [id], onDelete: Cascade)
  reviewer           User?            @relation("AppealReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@unique([userId, moderationActionId])
  @@index([status, createdAt])
}

// Server-authoritative activity and quest ledger. UTC period keys make daily
// and weekly progress deterministic across devices and time zones.
model ActivityEvent {
  id            String   @id @default(cuid())
  userId        String
  type          String
  eventKey      String?
  canonicalId   String?
  chapterNumber Float?
  value         Int      @default(1)
  metadata      Json?
  createdAt     DateTime @default(now())
  reversedAt    DateTime?
  reversalReason String?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, createdAt])
  @@index([userId, type, eventKey, createdAt])
  @@index([userId, reversedAt])
}

model QuestDefinition {
  id               String              @id
  name             String
  description      String
  cadence          String              @default("permanent") // daily | weekly | permanent | seasonal | hidden
  eventType        String
  target           Int
  xpReward         Int                 @default(0)
  badgeRewardId    String?
  titleRewardId    String?
  cosmeticRewardId String?
  canonicalId      String?
  // Route the quest card's GO ▸ key opens (e.g. "/library", "/feed").
  deepLink         String?
  distinctEvents   Boolean             @default(false)
  startsAt         DateTime?
  endsAt           DateTime?
  isActive         Boolean             @default(true)
  sortOrder        Int                 @default(0)
  createdAt        DateTime            @default(now())
  titleReward      TitleDefinition?    @relation("QuestTitleReward", fields: [titleRewardId], references: [id], onDelete: SetNull)
  cosmeticReward   CosmeticDefinition? @relation("QuestCosmeticReward", fields: [cosmeticRewardId], references: [id], onDelete: SetNull)
  progress         UserQuestProgress[]

  @@index([eventType, isActive])
}

model UserQuestProgress {
  id          String          @id @default(cuid())
  userId      String
  questId     String
  periodKey   String
  progress    Int             @default(0)
  completedAt DateTime?
  rewardedAt  DateTime?
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest       QuestDefinition @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId, periodKey])
  @@index([userId, completedAt])
  // Weekly-quests leaderboard: cross-user scan over a completedAt window.
  @@index([completedAt])
}

model XpTransaction {
  id         String   @id @default(cuid())
  userId     String
  delta      Int
  sourceType String
  sourceId   String
  reversalOf String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceType, sourceId])
  @@index([userId, createdAt])
}

model RewardGrant {
  id         String    @id @default(cuid())
  userId     String
  rewardType String // badge | title | cosmetic
  rewardId   String
  sourceType String
  sourceId   String
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, rewardType, rewardId, sourceType, sourceId])
  @@index([userId, createdAt])
}

// Safety: blocking hides the blocked user's posts/comments from the blocker
model Block {
  blockerId String
  blockedId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
}

model CommentLike {
  userId    String
  commentId String
  // Reaction type: like | hype | mindblown | pain | dead — same set as posts.
  type      String   @default("like")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, commentId])
  @@index([commentId, type])
}

model Series {
  id             String           @id @default(cuid())
  source         String // adapter id, e.g. "mangadex"
  sourceSeriesId String // the series' id on that source
  title          String
  altTitles      String[]
  coverUrl       String?
  description    String?
  status         String? // ongoing | completed | hiatus | cancelled | unknown
  tags           String[]
  fetchedAt      DateTime         @default(now()) // when we last refreshed from the source
  chapters       Chapter[]
  canonicalId    String?
  canonical      CanonicalSeries? @relation(fields: [canonicalId], references: [id])

  @@unique([source, sourceSeriesId])
  @@index([source])
  @@index([canonicalId])
}

model Chapter {
  id              String    @id @default(cuid())
  seriesId        String
  series          Series    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  sourceChapterId String // the chapter's id on the source
  number          Float // 10.5 for chapter 10.5
  title           String?
  publishedAt     DateTime?
  pages           Page[]
  pagesFetchedAt  DateTime? // when the page list was last refreshed

  @@unique([seriesId, sourceChapterId])
}

model Page {
  id        String  @id @default(cuid())
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  index     Int
  imageUrl  String
  headers   Json? // HTTP headers the app must send to load the image (e.g. Referer)

  @@unique([chapterId, index])
}

// ── Guilds ────────────────────────────────────────────────────────────────
// Small reader groups with their own hall, wall, level, and events.
// Guild level is driven by contribution flow (XP members earn while joined,
// which never drops); "power" (sum of member levels) is computed on read.
model Guild {
  id             String               @id @default(cuid())
  name           String               @unique
  tag            String               @unique // 2–5 chars, shown as [TAG]
  emblemKey      String               @default("crest") // app-owned SVG asset
  primaryColor   String               @default("#7C5CFF")
  secondaryColor String?
  motto          String?
  description    String?
  // Level-gated cosmetic hall decoration (curated key, see GUILD_DECORATIONS).
  decorationKey  String?
  joinPolicy     String               @default("open") // open | request | invite
  xp             Int                  @default(0) // contribution flow (never drops)
  guildmasterId  String
  createdAt      DateTime             @default(now())
  members        GuildMember[]
  joinRequests   GuildJoinRequest[]
  invites        GuildInvite[]
  events         GuildEvent[]
  xpTransactions GuildXpTransaction[]
  posts          Post[]
  warsAsA        GuildWar[]           @relation("WarsAsA")
  warsAsB        GuildWar[]           @relation("WarsAsB")
  raidProgress   GuildRaidProgress[]

  @@index([xp])
}

// One weekly head-to-head between two guilds. Paired lazily on first read of
// the war window (no cron): the score columns are refreshed from members'
// weeklyXp while the war is live, so the last write before rollover stands as
// the final score.
model GuildWar {
  id        String   @id @default(cuid())
  weekKey   String // Monday-anchored UTC week (guilds.ts currentWeekKey)
  guildAId  String
  guildBId  String
  scoreA    Int      @default(0)
  scoreB    Int      @default(0)
  // Set once the week is over: final scores frozen from the transaction log
  // and the winner's bonus paid (see finalizePastWars).
  finalizedAt DateTime?
  createdAt DateTime @default(now())
  guildA    Guild    @relation("WarsAsA", fields: [guildAId], references: [id], onDelete: Cascade)
  guildB    Guild    @relation("WarsAsB", fields: [guildBId], references: [id], onDelete: Cascade)

  @@unique([weekKey, guildAId])
  @@unique([weekKey, guildBId])
  @@index([guildAId, weekKey])
  @@index([guildBId, weekKey])
}

// Weekly shared raid: chapters cleared together this week. Progress ticks on
// every member chapter completion; claimedAt marks the one-time completion
// bonus so it can't be granted twice.
model GuildRaidProgress {
  guildId   String
  weekKey   String
  progress  Int       @default(0)
  claimedAt DateTime?
  guild     Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@id([guildId, weekKey])
}

model GuildMember {
  userId         String   @id // one guild per reader
  guildId        String
  role           String   @default("member") // guildmaster | officer | member
  contributionXp Int      @default(0) // all-time, this guild
  weeklyXp       Int      @default(0)
  weekKey        String   @default("")
  joinedAt       DateTime @default(now())
  guild          Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([guildId, weeklyXp])
  @@index([guildId, role])
}

model GuildJoinRequest {
  guildId   String
  userId    String
  createdAt DateTime @default(now())
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([guildId, userId])
}

model GuildInvite {
  guildId     String
  userId      String
  invitedById String
  createdAt   DateTime @default(now())
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user        User     @relation("GuildInviteRecipient", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy   User     @relation("GuildInviteSender", fields: [invitedById], references: [id], onDelete: Cascade)

  @@id([guildId, userId])
  @@index([userId, createdAt])
}

// Weekly co-op side quest, one per guild per week. The type rotates so it
// never duplicates the fixed chapter raid; progress pools from member
// activity while the week runs. completedAt doubles as the "bonus paid" flag.
model GuildEvent {
  id            String                   @id @default(cuid())
  guildId       String
  weekKey       String
  eventType     String // post_created | reply_created | reaction_received
  target        Int
  progress      Int                      @default(0)
  bonusXp       Int
  completedAt   DateTime?
  createdAt     DateTime                 @default(now())
  guild         Guild                    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  contributions GuildEventContribution[]

  @@unique([guildId, weekKey])
}

model GuildEventContribution {
  eventId String
  userId  String
  value   Int        @default(0)
  event   GuildEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
}

model GuildXpTransaction {
  id         String   @id @default(cuid())
  guildId    String
  userId     String
  delta      Int
  sourceType String   @default("activity")
  createdAt  DateTime @default(now())
  guild      Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
}

// Frozen leaderboard history (ARENA_PLAN phase 2). While a week is live the
// weekly_xp board is upserted by the 5-min tick (the per-user weekly window is
// destroyed lazily at rollover, so it can't be reconstructed later — ≤5 min of
// trailing XP is the accepted imprecision). Durable boards (weekly_quests,
// series:<canonicalId>) are computed and frozen once after the week ends.
// rows = [{ userId, value }] descending; identities resolve on read.
model LeaderboardSnapshot {
  id          String    @id @default(cuid())
  board       String // weekly_xp | weekly_quests | series:<canonicalId>
  periodKey   String // Monday-anchored UTC week key
  rows        Json
  finalizedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([board, periodKey])
  @@index([board, finalizedAt, periodKey])
}

// ── Gates ─────────────────────────────────────────────────────────────────
// Reddit-style communities inside the Dungeon. Readers may join many gates
// (unlike the one-guild rule). Visibility: open (anyone views/joins/posts),
// restricted (anyone views/joins, only authorized posters post — "SEALED"),
// private (invisible to non-members, entry by request — "HIDDEN").
model Gate {
  id             String            @id @default(cuid())
  name           String            @unique // 3–30 chars
  emblemKey      String            @default("crest") // shares the guild emblem catalog
  primaryColor   String            @default("#7C5CFF")
  secondaryColor String?
  description    String?
  visibility     String            @default("open") // open | restricted | private
  // The gatekeeper (head mod). Succession on leave mirrors guilds.
  ownerId        String
  createdAt      DateTime          @default(now())
  members        GateMember[]
  joinRequests   GateJoinRequest[]
  posts          Post[]

  @@index([createdAt])
}

model GateMember {
  userId         String
  gateId         String
  role           String   @default("member") // gatekeeper | warden | member
  // Restricted ("sealed") gates only: whether this member may post.
  approvedPoster Boolean  @default(false)
  joinedAt       DateTime @default(now())
  gate           Gate     @relation(fields: [gateId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, gateId])
  @@index([gateId, role])
}

// Entry requests for private ("hidden") gates.
model GateJoinRequest {
  gateId    String
  userId    String
  createdAt DateTime @default(now())
  gate      Gate     @relation(fields: [gateId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([gateId, userId])
}
