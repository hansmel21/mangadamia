# Port the scraper listens on (the main API points SCRAPER_URL here).
PORT=4000

# Shared secret. The main API must send this as the `x-scraper-key` header on
# every request. Generate a long random value and set the SAME value in the
# main API's SCRAPER_API_KEY. If unset, the service refuses to start.
SCRAPER_API_KEY=

# User-Agent used for MangaDex's documented API (attributed honestly).
# Scraped sites (Asura, Weeb Central) use a browser UA baked into http.ts.
APP_USER_AGENT=Mangadamia/1.0 (MangaDex API client)
